{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Database": {
    "Provider": "postgres",
    "AutoMigrate": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.printcraft.com",
      "https://www.printcraft.com"
    ]
  },
  "AllowedHosts": "*"
}
